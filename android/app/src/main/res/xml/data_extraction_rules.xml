<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 und neuer (android:dataExtractionRules), Begründung wie in backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
