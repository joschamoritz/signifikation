{
  "name": "signifikation",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "build": "vite build",
    "build:android": "cross-env VITE_API_BASE=https://signifikation.de vite build && npx cap sync android",
    "build:ios": "cross-env VITE_API_BASE=https://signifikation.de vite build && npx cap sync ios",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "verify": "npm run test && npm run build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capawesome/capacitor-apple-sign-in": "^0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@mollie/api-client": "^4.5.0",
    "async-lock": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.3.10",
    "better-sqlite3": "^12.8.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "node-apn": "^3.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pino": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.2.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.9.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.0"
  }
}
