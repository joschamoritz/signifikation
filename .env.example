# =============================================================
#  Signifikation – Umgebungsvariablen
#  Kopieren nach `.env` und Werte ausfüllen
#  Admin-Account erstellen: node server/setup-admin.js <email> <password>
# =============================================================

# --- Server -----------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# --- CORS -------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Auth (betterAuth) ------------------------------------
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=bitte-32-zeichen-plus-zufaellig-setzen

# Session-Laufzeit in Sekunden (Standard: 30 Tage / 12 Std. Rolling)
AUTH_SESSION_EXPIRES_IN=2592000
AUTH_SESSION_UPDATE_AGE=43200

# Passwort-Reset: "email" (Standard in Produktion) | "log" (dev) | "webhook" | "disabled"
#   email    – Versand über den Gmail-Transport unten (GMAIL_* muss gesetzt sein,
#              sonst bleibt das Feature aus und die App blendet es aus)
#   log      – Reset-Link landet im Serverlog; NUR Entwicklung, in Produktion
#              verweigert der Server den Start
#   webhook  – POST an PASSWORD_RESET_WEBHOOK_URL (Ausweichweg, z. B. n8n)
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_WEBHOOK_URL=

# --- Social Login: Apple ----------------------------------
# Sign in with Apple. Werte aus dem Apple Developer Portal.
# BETTER_AUTH_APPLE_CLIENT_ID    = Services-ID für den Web-Flow (z. B. de.signifikation.app.web)
# APPLE_BUNDLE_IDENTIFIER        = Bundle-ID der iOS-App (Default: de.signifikation.app)
# APPLE_TEAM_ID                  = 10-stellige Team-ID (oben rechts im Portal)
#                                  Auch für Universal Links (Classroom-QR öffnet die App):
#                                  speist /.well-known/apple-app-site-association.
# APPLE_KEY_ID                   = 10-stellige Key-ID des "Sign in with Apple"-Keys
# APPLE_PRIVATE_KEY_PATH         = Pfad zur AuthKey_XXXXXXXXXX.p8 (NIEMALS ins Repo committen!)
# Alternativ: APPLE_PRIVATE_KEY  = PEM-Inhalt direkt (mit \n als Zeilenumbruch)
# BETTER_AUTH_APPLE_CLIENT_SECRET= optional, statisches JWT-Secret (Fallback, nicht empfohlen)
# BETTER_AUTH_APPLE_CLIENT_ID=de.signifikation.app.web
# APPLE_BUNDLE_IDENTIFIER=de.signifikation.app
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./.secrets/AuthKey_XXXXXXXXXX.p8

# --- Klassenraum ------------------------------------------
CLASSROOM_JOIN_SECRET=bitte-starkes-secret-setzen

# --- Mollie Payments --------------------------------------
# test_... für Entwicklung, live_... für Produktion
MOLLIE_API_KEY=test_...

# --- Apple In-App Purchase ---------------------------------
# Sandbox-Transaktionen (TestFlight) akzeptieren: NUR per explizitem Opt-in
# (Default: aus). Sandbox-JWS sind echte Apple-Signaturen, mit denen sich
# sonst ohne Bezahlung freischalten ließe. Fuer TestFlight-Phasen aktivieren:
# IAP_ALLOW_SANDBOX=1
#
# ACHTUNG App-Store-Review: Der Apple-Reviewer kauft IMMER mit einem
# Sandbox-Account. Ist diese Variable waehrend des Reviews nicht gesetzt,
# schlaegt sein Testkauf fehl -> sicherer Reject nach Guideline 2.1.
# Vor jeder Einreichung setzen, nach der Freigabe wieder entfernen.
# Siehe Release-Checkliste in OPS.md.
# Sobald die Legacy-Kaeufe (vor Token-Bindung) migriert sind: JWS ohne
# appAccountToken hart ablehnen (schliesst Account-Replay endgueltig):
# IAP_REQUIRE_ACCOUNT_TOKEN=1

# --- Google Play Billing (Android-App) ---------------------
# Schlüssel des Dienstkontos play-kauf@signifikation.iam.gserviceaccount.com
# (Play Console: „Finanzdaten ansehen“ + „Bestellungen und Abos verwalten“).
# Ohne Datei antworten /api/v1/iap/play/* mit 503. Einrichtung: OPS.md.
# PLAY_SERVICE_ACCOUNT_PATH=/opt/signifikation/keys/play-kauf.json
# Pub/Sub-Push der Real-Time Developer Notifications (Erstattungen):
# Audience und Dienstkonto, mit denen das Push-Abo sein OIDC-Token ausstellt.
# PLAY_PUBSUB_AUDIENCE=https://signifikation.de/api/v1/iap/play/notifications
# PLAY_PUBSUB_SA_EMAIL=pubsub-push@signifikation.iam.gserviceaccount.com
# Testkäufe von Lizenztestern annehmen (kosten nichts!) – nur für Testphasen:
# PLAY_ALLOW_TEST=1

# --- Apple Push (APNs, native iOS-App) ----------------------
# .p8-Key aus dem Apple Developer Portal; Pfad muss fuer den Serverprozess
# lesbar sein (Deploy-Workflow prueft das, Lesson-Learned Outage 2026-05-26).
# APNS_KEY_PATH=/opt/signifikation/keys/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX

# --- Vorschlags-API (Entwurfs-Postfach) --------------------
# Geplante Tage kommen per Schlüssel als Entwurf ins Admin-Panel („Vorschläge").
# Schlüssel erzeugen: npm run lemma:key (schreibt LEMMA_API_KEY in die lokale
# .env und gibt den Hash für den Server aus).
#
# SERVER: nur der SHA-256-Hash. Ohne Wert ist die API aus (503).
# LEMMA_API_KEY_SHA256=
#
# LOKAL (für npm run lemma:push): der Schlüssel selbst und das Ziel.
# LEMMA_API_KEY=
# LEMMA_API_URL=https://signifikation.de

# --- Web Push (VAPID) -------------------------------------
# Keys generieren: siehe `server/notifications/vapid-keys.txt`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@signifikation.de

# --- E-Mail (Systemmails) ----------------------------------
# Versendet werden: Bestellbestätigung (Mollie + In-App-Kauf), Willkommensmail
# nach der Registrierung und der Passwort-Reset-Link. Ohne diese Werte laufen
# alle drei ins Leere – der Server warnt dann beim Start.
#
# PRODUKTION: Mailjet (SMTP-Relay). Gmail geht hier nicht, weil der Absender
# info@signifikation.de lautet und Gmail nur für gmail.com signiert – Yahoo &
# Co. lehnen das seit 2024 rundheraus ab ("sender is unauthenticated,
# DKIM = FAILURE"). Der Anbieter signiert die eigene Domain, dafür müssen die
# DKIM-Records im DNS stehen (Anleitung + Ist-Zustand: OPS.md → Systemmails).
# Zugangsdaten: Mailjet → Account → API Key Management (User = API-Key,
# Passwort = Secret-Key).
SMTP_HOST=in.mailjet.com
SMTP_PORT=587
SMTP_USER=dein-mailjet-api-key
SMTP_PASSWORD=dein-mailjet-secret-key
MAIL_FROM=info@signifikation.de
#
# Warum nicht Brevo: baut in jede Transaktionsmail zwei Öffnungs-Zählpixel ein
# und lässt das nicht abschalten (nur "anonymisieren", der Pixel bleibt). Das
# widerspricht der Zusage "Keine Analyse- oder Tracking-Tools" in der
# Datenschutzerklärung und kostet bei SpamAssassin 2,5 Punkte
# (FONT_INVIS_MSGID, gemessen 2026-08-10: 6,7/10). Mailjet schaltet es per
# Header ab – siehe NO_TRACKING_HEADERS in server/mailer.js.
# Brevo-Werte als Rückfall: SMTP_HOST=smtp-relay.brevo.com, User/Passwort aus
# Brevo → SMTP & API.
#
# Port 587 ist auf dem Hetzner-Server Pflicht: ausgehend sind 25 und 465
# gesperrt (gemessen 2026-08-10), nur 587 ist offen. Symptom bei falschem Port
# ist "Connection timeout" (ETIMEDOUT) beim Verbindungsaufbau – das sieht nicht
# nach einem Auth-Problem aus und ist auch keins.
#
# Rückfall auf Gmail (nur Entwicklung/Notfall): SMTP_HOST leer lassen und
# stattdessen die alten Namen setzen. Der Code nimmt sie, wenn SMTP_USER/
# SMTP_PASSWORD fehlen – Absender muss dann die Gmail-Adresse selbst sein,
# sonst scheitert die Authentifizierung wie oben beschrieben.
# GMAIL_USER=deine@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Datenbank-Pfade (optional – nur wenn nicht Standard) -
# APP_DB=/pfad/zur/signifikation.db
# BELEGE_DB=/pfad/zur/belege.db
# WORTPROFIL_DB=/pfad/zur/wortprofil.db

# --- Belegprüfung (optional) ------------------------------
# Python der Prüf-Umgebung mit spaCy + de_zdl_lg (OPS.md „Belegprüfung“).
# Leer = aus: Belege werden ungeprüft wie bisher angezeigt.
# BELEGPRUEFUNG_PYTHON=/opt/signifikation/belegpruefung-env/bin/python
# BELEGPRUEFUNG_DWDSMOR=1        dwdsmor zuschalten (Standard aus, kaum Unterschied)

# --- Alerting (optional) ----------------------------------
# Ohne URL laeuft Alerting im Log-only-Modus (Warn-Logs statt Webhook).
# Webhook-URL für POST-Alerts (Discord, Slack, n8n, …)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...
# Schwellwerte (optional – Standardwerte):
# EVENT_LOOP_LAG_THRESHOLD_MS=100
# ERROR_5XX_THRESHOLD=10
# QUEUE_STALL_THRESHOLD_MS=600000

# --- Backup -------------------------------------------------
# Tägliches Voll-Backup der signifikation.db (Online-Backup-API + gzip).
# Läuft immer – Default-Verzeichnis: <DB-Verzeichnis>/backups
# Offsite empfohlen: SQLITE_BACKUP_DIR auf anderen Mount zeigen lassen
# oder das Verzeichnis extern wegsynchronisieren.
# SQLITE_BACKUP_DIR=/pfad/zu/backups
# SQLITE_BACKUP_KEEP=7   (Tage bzw. Stände; gleiche Frist wie die Sicherungen des Signifikatoriums)

# Altes GitHub-Gist-Backup (nur Spieldaten!) – leer lassen = deaktiviert
# GITHUB_GIST_TOKEN=ghp_...
# BACKUP_KEEP=5

# --- Social Cards / Bluesky ------------------------------------
# Entwürfe entstehen täglich um 04:20 (Admin › Werkzeuge › Social Cards).
# SOCIAL_CARDS_ENTWUERFE=off   Zeitplan abschalten (Knopf im Admin bleibt)
# SOCIAL_CARDS_DIR=/pfad       Ablage der Kartenbilder (Standard: <DB-Verzeichnis>/social-cards)
#
# Veröffentlichen freigegebener Entwürfe auf Bluesky ab 18:30 Uhr:
# SOCIAL_POSTEN=off            off (Standard) · test (nur ins Log) · on (postet wirklich)
# BLUESKY_HANDLE=signifikation.de
# BLUESKY_APP_PASSWORD=        App-Passwort OHNE Zugriff auf Direktnachrichten – nur in der Server-.env
# BLUESKY_SERVICE=https://bsky.social
