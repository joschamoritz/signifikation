# =============================================================
#  Signifikation – Umgebungsvariablen
#  Kopieren nach `.env` und Werte ausfüllen
#  Admin-Account erstellen: node server/setup-admin.js <email> <password>
# =============================================================

# --- Server -----------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# --- CORS -------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Auth (betterAuth) ------------------------------------
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=bitte-32-zeichen-plus-zufaellig-setzen

# Session-Laufzeit in Sekunden (Standard: 30 Tage / 12 Std. Rolling)
AUTH_SESSION_EXPIRES_IN=2592000
AUTH_SESSION_UPDATE_AGE=43200

# Passwort-Reset: "log" (dev) | "webhook" | "disabled"
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_WEBHOOK_URL=

# --- Social Login: Apple ----------------------------------
# Sign in with Apple. Werte aus dem Apple Developer Portal.
# BETTER_AUTH_APPLE_CLIENT_ID    = Services-ID für den Web-Flow (z. B. de.signifikation.app.web)
# APPLE_BUNDLE_IDENTIFIER        = Bundle-ID der iOS-App (Default: de.signifikation.app)
# APPLE_TEAM_ID                  = 10-stellige Team-ID (oben rechts im Portal)
#                                  Auch für Universal Links (Classroom-QR öffnet die App):
#                                  speist /.well-known/apple-app-site-association.
# APPLE_KEY_ID                   = 10-stellige Key-ID des "Sign in with Apple"-Keys
# APPLE_PRIVATE_KEY_PATH         = Pfad zur AuthKey_XXXXXXXXXX.p8 (NIEMALS ins Repo committen!)
# Alternativ: APPLE_PRIVATE_KEY  = PEM-Inhalt direkt (mit \n als Zeilenumbruch)
# BETTER_AUTH_APPLE_CLIENT_SECRET= optional, statisches JWT-Secret (Fallback, nicht empfohlen)
# BETTER_AUTH_APPLE_CLIENT_ID=de.signifikation.app.web
# APPLE_BUNDLE_IDENTIFIER=de.signifikation.app
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./.secrets/AuthKey_XXXXXXXXXX.p8

# --- Klassenraum ------------------------------------------
CLASSROOM_JOIN_SECRET=bitte-starkes-secret-setzen

# --- Mollie Payments --------------------------------------
# test_... für Entwicklung, live_... für Produktion
MOLLIE_API_KEY=test_...

# --- Apple In-App Purchase ---------------------------------
# Sandbox-Transaktionen (TestFlight) akzeptieren: NUR per explizitem Opt-in
# (Default: aus). Sandbox-JWS sind echte Apple-Signaturen, mit denen sich
# sonst ohne Bezahlung freischalten ließe. Fuer TestFlight-Phasen aktivieren:
# IAP_ALLOW_SANDBOX=1
# Sobald die Legacy-Kaeufe (vor Token-Bindung) migriert sind: JWS ohne
# appAccountToken hart ablehnen (schliesst Account-Replay endgueltig):
# IAP_REQUIRE_ACCOUNT_TOKEN=1

# --- Wortprofil-Auto-Download (optional, Legacy/Sondersetups) ---
# Standard-Deploy liefert wortprofil.db mit. Auto-Download nur aktivieren,
# wenn die DB beim Boot fehlen kann (z.B. ephemere Container):
# WORTPROFIL_AUTODOWNLOAD=1
# WORTPROFIL_DB_PATH=/opt/signifikation/app/wortprofil/05_db/wortprofil.db
# WORTPROFIL_DOWNLOAD_URL=https://github.com/.../wortprofil.db.gz

# --- Apple Push (APNs, native iOS-App) ----------------------
# .p8-Key aus dem Apple Developer Portal; Pfad muss fuer den Serverprozess
# lesbar sein (Deploy-Workflow prueft das, Lesson-Learned Outage 2026-05-26).
# APNS_KEY_PATH=/opt/signifikation/keys/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX

# --- Web Push (VAPID) -------------------------------------
# Keys generieren: siehe `server/notifications/vapid-keys.txt`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@signifikation.de

# --- E-Mail (Bestellbestätigungen via Gmail) ---------------
# App-Passwort erstellen: Google-Konto → Sicherheit → 2FA → App-Passwörter
# GMAIL_FROM optional: nur nötig wenn "Send mail as"-Alias in Gmail konfiguriert
GMAIL_USER=deine@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# GMAIL_FROM=info@signifikation.de

# --- Datenbank-Pfade (optional – nur wenn nicht Standard) -
# APP_DB=/pfad/zur/signifikation.db
# BELEGE_DB=/pfad/zur/belege.db
# WORTPROFIL_DB=/pfad/zur/wortprofil.db

# --- Alerting (optional) ----------------------------------
# Ohne URL laeuft Alerting im Log-only-Modus (Warn-Logs statt Webhook).
# Webhook-URL für POST-Alerts (Discord, Slack, n8n, …)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...
# Schwellwerte (optional – Standardwerte):
# EVENT_LOOP_LAG_THRESHOLD_MS=100
# ERROR_5XX_THRESHOLD=10
# QUEUE_STALL_THRESHOLD_MS=600000

# --- Backup -------------------------------------------------
# Tägliches Voll-Backup der signifikation.db (Online-Backup-API + gzip).
# Läuft immer – Default-Verzeichnis: <DB-Verzeichnis>/backups
# Offsite empfohlen: SQLITE_BACKUP_DIR auf anderen Mount zeigen lassen
# oder das Verzeichnis extern wegsynchronisieren.
# SQLITE_BACKUP_DIR=/pfad/zu/backups
# SQLITE_BACKUP_KEEP=14

# Altes GitHub-Gist-Backup (nur Spieldaten!) – leer lassen = deaktiviert
# GITHUB_GIST_TOKEN=ghp_...
# BACKUP_KEEP=5
