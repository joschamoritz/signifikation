# Admin-User: Erstelle mit `node server/setup-admin.js <email> <password>`
# Nutze betterAuth für Admin-Login (nicht mehr über ADMIN_KEY)

# Optional
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
CLASSROOM_JOIN_SECRET=bitte-starkes-secret-setzen
CLASSROOM_EXPORT_WORKER_ENABLED=true
CLASSROOM_EXPORT_WORKER_INTERVAL_MS=3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=bitte-32-zeichen-plus-und-zufaellig
AUTH_SESSION_EXPIRES_IN=2592000
AUTH_SESSION_UPDATE_AGE=43200
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_APPLE_CLIENT_ID=
BETTER_AUTH_APPLE_CLIENT_SECRET=
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_WEBHOOK_URL=

# Backup (optional – nur wenn automatisches GitHub-Gist-Backup gewünscht)
GITHUB_GIST_TOKEN=ghp_...
BACKUP_KEEP=5
